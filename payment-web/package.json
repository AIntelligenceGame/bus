{
  "name": "payment-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "支付平台前端(Vite + TypeScript),构建产物输出到 ../payment/platform/web/dist,由 Go 端 embed 打包",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
